<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Model prywatnosci: aplikacja jest w pelni lokalna i NIE laczy sie z internetem.
        Ponizsze usuniecie uprawnien jest celowe - dzieki niemu zadna biblioteka (np. ML Kit)
        nie moze po cichu dodac dostepu do sieci w manifeście scalonym.
        Weryfikacja w CI: `apkanalyzer manifest print` + grep (patrz .github/workflows).
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Skaner kodów i OCR etykiet: prosimy o kamere dopiero przy wejsciu w funkcje skanowania. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Przypomnienia o terminach: kanal powiadomien + dokladne alarmy (opcjonalne, z fallbackiem). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Ponowne zaplanowanie przypomnien po restarcie telefonu / zmianie czasu i strefy. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        CELOWO NIE OBECNE:
        - brak uprawnien do pamieci (READ/WRITE_EXTERNAL_STORAGE, MANAGE_EXTERNAL_STORAGE):
          zdjecia i kopie zapasowe obslugujemy przez systemowe pickery SAF,
        - brak uprawnien lokalizacji,
        - brak REQUEST_INSTALL_PACKAGES, reklam i analityki.
    -->

    <application
        android:name=".TerminownikApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Terminownik"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Terminownik.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Odbiornik wlasnych alarmow przypomnien (PendingIntent z naszej aplikacji). -->
        <receiver
            android:name=".notifications.ReminderAlarmReceiver"
            android:exported="false" />

        <!--
            Odbiornik zdarzen systemowych. Wszystkie akcje to chronione broadcasty systemowe,
            ktorych nie moze wyslac inna aplikacja, dlatego exported=true nie poszerza ataku.
        -->
        <receiver
            android:name=".notifications.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Wlasna inicjalizacja WorkManager (bez domyslnej, zeby miec pelna kontrole). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
